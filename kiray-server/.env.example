# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# API
API_VERSION=v1

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Kiray?retryWrites=true&w=majority

# Firebase (paste full service account JSON as a single-line string)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id"}

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Mapbox (for server-side geocoding)
MAPBOX_ACCESS_TOKEN=pk.your_token
